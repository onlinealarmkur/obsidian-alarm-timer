{
  "name": "alarm-timer",
  "version": "1.1.0",
  "private": true,
  "description": "Set one-time alarms for specific times and run multiple countdown timers from the sidebar.",
  "type": "module",
  "main": "main.js",
  "engines": {
    "node": ">=24 <25"
  },
  "releaseAssets": [
    "main.js",
    "manifest.json",
    "styles.css"
  ],
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "obsidian:dev": "node esbuild.config.mjs",
    "obsidian:install": "npm run build && node scripts/install-test-vault.mjs",
    "obsidian:smoke": "node scripts/obsidian-smoke.mjs",
    "lint": "eslint . --max-warnings 0",
    "check:peers": "node scripts/check-peer-dependencies.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "npm run typecheck:project && npm run typecheck:production",
    "typecheck:project": "tsc --noEmit",
    "typecheck:production": "tsc --noEmit -p tsconfig.production.json",
    "typecheck:min-obsidian": "tsc --noEmit -p tsconfig.min-obsidian.json",
    "check:fast": "npm run check:peers && npm run lint && npm run typecheck && npm test",
    "check": "npm run check:peers && npm run validate:release && npm run lint && npm run test:coverage && npm run typecheck:min-obsidian && npm run build"
  },
  "keywords": [
    "obsidian",
    "alarm",
    "timer"
  ],
  "author": "Burak Ozdemir",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.13.0",
    "obsidian": "^1.14.4",
    "obsidian-min": "npm:obsidian@1.10.0",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "moment": "^2.31.0"
  }
}
